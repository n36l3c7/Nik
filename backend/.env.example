# Nik backend environment configuration.
# Copy to `.env` and adjust for your environment.

# Database connection string.
# Dev default (used if unset): a local SQLite file — no external DB required.
#   sqlite:///./nik.db
# Production example (PostgreSQL via psycopg 3):
#   postgresql+psycopg://nik:CHANGE_ME@localhost/nik
# NOTE: in a URL the password must be percent-encoded. Alternative that needs
# no encoding: leave DATABASE_URL unset and set the DB_* parts instead
# (DB_PASSWORD required; DB_USER/DB_HOST/DB_PORT/DB_NAME optional) — the app
# escapes them itself.
DATABASE_URL=sqlite:///./nik.db

# Secret key used for signing/entropy. Set a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# Whether the session cookie is marked Secure (HTTPS-only).
# Set to false for plain-HTTP local development; keep true in production.
COOKIE_SECURE=true

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Malware samples: directory of the raw files (named by SHA-256, never
# executed) and the per-file size limit. Exclude the directory from the
# server's antivirus and include it in backups: the database holds only the
# analysis results, not the bytes.
SAMPLE_STORE=./samples
SAMPLE_MAX_MB=100
# Built-in YARA rule files (*.yar). Defaults to the app/malware/yara directory of the
# installation; admin-added rules live in the database.
# YARA_RULES=/opt/nik/yara

# Analyzer worker (rizin, see workers/analyzer/) for disassembly, functions and graphs.
# Leave ANALYZER_URL empty to run without it (the Code view says so).
# ANALYZER_URL=http://127.0.0.1:8700
# ANALYZER_TOKEN=a-long-random-shared-secret
# ANALYZER_TIMEOUT=600
# capa worker (workers/capa/) for the Capabilities view of malware samples.
# Leave CAPA_URL empty to run without it (the view says so).
# CAPA_URL=http://127.0.0.1:8710
# CAPA_TOKEN=another-long-random-shared-secret
# CAPA_TIMEOUT=1800
# Document viewer (workers/docview/) and isolated browser (workers/browser/) for previews of
# mail attachments. Leave the URLs empty to run without them.
# DOCVIEW_URL=http://127.0.0.1:8720
# DOCVIEW_TOKEN=a-third-shared-secret
# BROWSER_URL=http://127.0.0.1:8730
# BROWSER_TOKEN=a-fourth-shared-secret
# Packet capture worker (workers/pcap/) for Network Analysis; captures up to PCAP_MAX_MB.
# PCAP_URL=http://127.0.0.1:8740
# PCAP_TOKEN=a-fifth-shared-secret
# PCAP_MAX_MB=500
