{
  "app": "Nik",
  "type": "playbook",
  "version": 1,
  "playbook": {
    "name": "Analyse the attachments of an e-mail",
    "description": "When an e-mail is analysed, each of its attachments is taken out and kept as a file of its own, in the incident the e-mail is in when there is one: analysed as an uploaded file is, never run or opened. The e-mail is tagged \"flagged-attachment\" when the analysis of one of them gives a verdict (a YARA rule that matched, a file that is mostly packed or encrypted). It does nothing outside Nik. Messages imported from a mailbox are left alone.",
    "graph": {
      "nodes": [
        {
          "id": "start",
          "kind": "trigger",
          "name": "An e-mail with attachments",
          "position": {
            "x": 60,
            "y": 40
          },
          "config": {
            "event": "mail.analysed",
            "manual": true,
            "conditions": {
              "all": [
                {
                  "left": "{{ trigger.mail.attachments | length }}",
                  "op": "gt",
                  "right": 0
                },
                {
                  "left": "{{ trigger.from_mailbox }}",
                  "op": "empty"
                }
              ]
            }
          }
        },
        {
          "id": "each",
          "kind": "for_each",
          "name": "For each attachment",
          "position": {
            "x": 60,
            "y": 170
          },
          "config": {
            "items": "{{ trigger.mail.attachments }}",
            "max": 50
          }
        },
        {
          "id": "take",
          "kind": "action",
          "name": "Keep it as a file",
          "position": {
            "x": 60,
            "y": 300
          },
          "config": {
            "action": "nik.add-file",
            "args": {
              "artifact": "{{ trigger.mail.artifact_id }}",
              "attachment": "{{ item.name }}"
            }
          }
        },
        {
          "id": "analyse",
          "kind": "action",
          "name": "Analyse it",
          "position": {
            "x": 60,
            "y": 430
          },
          "config": {
            "action": "nik.analyse-artifact",
            "args": {
              "artifact": "{{ take.artifact }}",
              "wait": true,
              "wait_minutes": 15
            }
          }
        },
        {
          "id": "found",
          "kind": "action",
          "name": "What the analysis found",
          "position": {
            "x": 60,
            "y": 560
          },
          "config": {
            "action": "nik.get-analysis",
            "args": {
              "artifact": "{{ take.artifact }}"
            }
          }
        },
        {
          "id": "flagged",
          "kind": "condition",
          "name": "Does it have a verdict?",
          "position": {
            "x": 60,
            "y": 690
          },
          "config": {
            "all": [
              {
                "left": "{{ found.verdict }}",
                "op": "in",
                "right": [
                  "high",
                  "medium"
                ]
              }
            ]
          }
        },
        {
          "id": "tag",
          "kind": "action",
          "name": "Tag the e-mail",
          "position": {
            "x": 60,
            "y": 820
          },
          "config": {
            "action": "nik.add-artifact-tags",
            "args": {
              "artifact": "{{ trigger.mail.artifact_id }}",
              "tags": [
                "flagged-attachment"
              ]
            }
          }
        }
      ],
      "edges": [
        {
          "from": "start",
          "to": "each"
        },
        {
          "from": "each",
          "to": "take",
          "port": "each"
        },
        {
          "from": "take",
          "to": "analyse"
        },
        {
          "from": "analyse",
          "to": "found"
        },
        {
          "from": "found",
          "to": "flagged"
        },
        {
          "from": "flagged",
          "to": "tag",
          "port": "yes"
        }
      ],
      "inputs": []
    },
    "maxRunsPerHour": 60,
    "onePerObject": true,
    "maxSeconds": 86400,
    "approvalDefault": true
  }
}
