# Settings of the Compose stack. Do not copy this file by hand:
#
#   deploy/init-env.sh
#
# creates .env from it and replaces every placeholder secret below with a
# fresh random value. The stack refuses to start with the placeholders, which
# are public. Keep .env with your backups (see SECRET_KEY).

# PostgreSQL password (used by both the db and api services). Any character
# is fine; only if it contains # or $ wrap the value in single quotes. It is
# set when the database is first created: to change it later, change it in
# PostgreSQL too (ALTER ROLE nik PASSWORD '…').
DB_PASSWORD=change-this-db-password

# Encrypts the secrets stored in the database (threat-intelligence API keys,
# TLS key logs of captures). Without it they cannot be read again: keep it
# with the backups. To change it, put the old value in SECRET_KEY_PREVIOUS
# for one start: what is stored is re-encrypted with the new one.
SECRET_KEY=change-this-to-a-long-random-string

# Host port for plain HTTP. It serves nothing: every request is redirected to
# the HTTPS port below.
WEB_PORT=8080

# Host port for HTTPS. A self-signed certificate is generated on first start
# unless you mount your own into the web-certs volume (see the README).
WEB_TLS_PORT=8443

# Hostname embedded in the auto-generated certificate (CN + SAN). Set it to
# whatever users type in the browser, e.g. nik.example.internal.
TLS_HOSTNAME=localhost

# Session lifetime (hours).
SESSION_TTL_HOURS=12

# Limits of the backend container (it parses the evidence).
API_MEMORY=4g
API_CPUS=4

# Optional: a token Prometheus must send (Authorization: Bearer …) to read
# /api/metrics. The endpoint is never published by nginx: scrape
# http://api:8000/api/metrics from the compose network.
#METRICS_TOKEN=

# Per-file size limit for malware samples uploaded to the Malware Analysis tab.
SAMPLE_MAX_MB=100

# Analyzer worker (rizin) for the Code view: shared secret between the api and
# analyzer services (use a long random value, e.g. `openssl rand -hex 32`),
# per-sample time limit in seconds, the part of it spent decompiling functions
# up front (the rest are decompiled when first opened), the safety cap on the
# functions listed per sample, the analysed sessions kept open so that
# decompiling on demand takes seconds (each holds ~1 GB on a large binary; 0
# disables) and how long an unused one stays open, and the worker's memory /
# CPU limits.
ANALYZER_TOKEN=please-change-this-analyzer-token
ANALYZER_TIMEOUT=600
ANALYZER_MAX_JOBS=2
ANALYZER_DECOMPILE_SECONDS=300
ANALYZER_MAX_FUNCTIONS=20000
ANALYZER_WARM_SESSIONS=1
ANALYZER_WARM_IDLE=600
ANALYZER_MEMORY=4g
ANALYZER_CPUS=2

# capa worker for the Capabilities view: its own shared secret, per-sample
# time limit in seconds (large binaries take ten minutes or more) and the
# worker's memory / CPU limits.
CAPA_TOKEN=please-change-this-capa-token
CAPA_TIMEOUT=1800
CAPA_MEMORY=4g
CAPA_CPUS=2

# Mail attachment previews: document viewer (LibreOffice + pdfium) and
# isolated browser (Chromium). Their own shared secrets and limits.
DOCVIEW_TOKEN=please-change-this-docview-token
DOCVIEW_MEMORY=2g
DOCVIEW_CPUS=1
BROWSER_TOKEN=please-change-this-browser-token
BROWSER_MAX_SESSIONS=3
BROWSER_MEMORY=2g
BROWSER_CPUS=2

# Packet capture worker (Network Analysis, Wireshark's engine): its shared
# secret, the largest capture accepted (MB) and its memory / CPU limits
# (sharkd keeps an open capture in memory: a few times its size).
PCAP_TOKEN=please-change-this-pcap-token
PCAP_MAX_MB=500
PCAP_MEMORY=4g
PCAP_CPUS=2
