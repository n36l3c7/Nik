{
  "incoming": [
    {
      "to": "name",
      "from": "{{ item.threatInfo.threatName }} on {{ item.agentRealtimeInfo.agentComputerName }}"
    },
    {
      "to": "details",
      "from": "{{ item.threatInfo.classification }}: {{ item.threatInfo.filePath }}"
    },
    {
      "to": "severity",
      "from": "{{ item.threatInfo.confidenceLevel | map(malicious='high', suspicious='medium', else='low') }}"
    },
    {
      "to": "status",
      "from": "{{ item.threatInfo.incidentStatus | map(unresolved='open', in_progress='in_progress', resolved='closed', else='') }}"
    },
    {
      "to": "close_reason",
      "from": "{{ item.threatInfo.analystVerdict | map(true_positive='Resolved', false_positive='False positive', else='') }}"
    },
    {
      "to": "source_id",
      "from": "{{ item.id }}"
    },
    {
      "to": "Alert(val.ID == obj.ID)",
      "from": {
        "ID": "{{ item.id }}",
        "Name": "{{ item.threatInfo.threatName }}",
        "Severity": "{{ item.threatInfo.confidenceLevel }}",
        "Source": "SentinelOne",
        "Time": "{{ item.threatInfo.createdAt }}"
      }
    },
    {
      "to": "Host(val.Name == obj.Name)",
      "from": {
        "Name": "{{ item.agentRealtimeInfo.agentComputerName }}",
        "AgentID": "{{ item.agentRealtimeInfo.agentId }}"
      }
    },
    {
      "to": "File(val.SHA256 == obj.SHA256)",
      "from": {
        "Name": "{{ item.threatInfo.threatName }}",
        "SHA1": "{{ item.threatInfo.sha1 }}",
        "SHA256": "{{ item.threatInfo.sha256 }}",
        "Path": "{{ item.threatInfo.filePath }}"
      }
    }
  ],
  "outgoing": [
    {
      "to": "incidentStatus",
      "from": "{{ incident.status | map(open='unresolved', in_progress='in_progress', closed='resolved', else='') }}"
    },
    {
      "to": "analystVerdict",
      "from": "{{ incident.close_reason | map('resolved', 'true_positive', 'true positive', 'true_positive', 'false positive', 'false_positive', 'suspicious', 'suspicious', else='') }}"
    }
  ],
  "classifier": {
    "rules": [],
    "defaultType": null
  }
}
