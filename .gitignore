node_modules
dist
# Playwright output
test-results/
playwright-report/
*.local
.DS_Store

# Test forensic artifacts (may contain real data: do not commit)
*.sqlite
*.sqlite-wal
*.sqlite-shm
places.sqlite
History
Bookmarks
Shortcuts
History.db
History.db-wal
History.db-shm
Downloads.plist
Bookmarks.plist
# Synthetic test fixtures (no real data) are the exception.
!frontend/e2e/fixtures/*

# Environment files with real secrets (docker-compose reads ./.env)
.env
# The secrets as files (deploy/init-env.sh, deploy/secrets.sh), the key kept after a change of
# SECRET_KEY on a server whose secrets are in .env, and the .env kept from before a move
/secrets/
/secrets-retired/
.env.before-*

# Backend (Python)
backend/.venv/
__pycache__/
.pytest_cache/
backend/*.db
# Malware sample store (dev default; production sets SAMPLE_STORE)
backend/samples/
backend/.e2e-samples/
# Backups (dev default; production sets BACKUP_DIR)
backend/backups/
backend/.e2e-backups/
backend/.env
